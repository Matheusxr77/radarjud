# Configuração do Ambiente LexGuard AI
FLASK_ENV=development
FLASK_APP=run.py
DEBUG=True
PORT=5000
SECRET_KEY=lexguard-secret-key-change-in-production

# Banco de Dados PostgreSQL (Containerizado)
# No docker-compose, o host é 'db'. Para execução local fora do Docker, use 'localhost'.
POSTGRES_USER=radarjud
POSTGRES_PASSWORD=radarjud_secret_pass
POSTGRES_DB=radarjud
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://radarjud:radarjud_secret_pass@db:5432/radarjud

# APIs Públicas Oficiais do Judiciário
# API Pública DataJud CNJ (Chave pública padrão fornecida pelo CNJ)
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# API Pública Comunica PJe (Diário de Justiça Eletrônico / Intimações)
COMUNICA_PJE_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao

# Configurações de Conectividade e Resiliência
REQUEST_TIMEOUT_SECONDS=20
MAX_PROCESSES_PER_QUERY=100
CACHE_EXPIRATION_HOURS=24

